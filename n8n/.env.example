# Atlas's own Tailscale interface IP (`tailscale ip -4`). Same value as the
# root `.env`'s `ATLAS_TAILSCALE_IP` — kept out of source because a re-keyed
# Tailscale identity changes it.
ATLAS_TAILSCALE_IP=

# The public-facing URL for this n8n instance — Atlas's own Tailscale
# MagicDNS name (`tailscale status` → `Self.DNSName`), fronted by
# `tailscale serve` on 443 (see compose.yaml's comment; run once on Atlas,
# not part of this compose file). Used so n8n builds a real, HTTPS OAuth2
# redirect URI — Google rejects a bare IP or a plain-HTTP one. Same value
# in both: WEBHOOK_URL is what the OAuth2 callback URL actually reads,
# N8N_EDITOR_BASE_URL covers the frontend's own UI links.
N8N_EDITOR_BASE_URL=
WEBHOOK_URL=
