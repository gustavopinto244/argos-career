# Job Radar
# Copie este arquivo para .env e preencha as credenciais do bot exclusivo
# desta aplicação. Não reutilize o bot do aplicativo principal.

TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000

# Banco independente do aplicativo principal.
DATABASE_PATH=./data/job-radar.db

# Configuração de busca e agenda.
JOB_RADAR_CONFIG_PATH=./config/job-radar.yaml
