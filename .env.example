# ArgosCareer — environment template
#
# Copy to .env and fill in. .env is gitignored; this file is not.
# Only credentials and endpoints belong here. Anything that is a *decision*
# belongs in config/criteria.yaml, where it can be diffed. See
# docs/09-configuration.md.

# --- Telegram delivery -------------------------------------------------------
# Bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat that receives the digest and alerts. Required.
TELEGRAM_CHAT_ID=000000000

# --- Scoring engine ----------------------------------------------------------
# Which ScorerPort adapter to use: stub | api
# stub — fixed score, no model. Used by tests and the M6 vertical slice.
# api  — hosted model (OpenRouter). Production (ADR-012/013/016). A local
#        model (OllamaScorer) was evaluated during M7/M8 and retired — it
#        never finished a real calibration pass, and `api`'s real measured
#        cost and memory footprint (cents per batch, ~30 MiB at rest on
#        Atlas) left no case for running a model on shared hardware. See
#        ADR-016 for the full reasoning.
SCORER_ADAPTER=stub

# Required when SCORER_ADAPTER=api. OpenRouter key (ADR-012) — a single
# OpenAI-compatible endpoint in front of many providers, so comparing
# candidate models during calibration is a config change (LLM_MODEL), never
# an adapter change.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model slug, e.g. deepseek/deepseek-v4-flash-0731.
LLM_MODEL=

# --- Jooble (fonte aggregadora, PARKED -- setting this has no effect) --------
# No JoobleCollector exists in src/ and nothing reads this variable
# (docs/audit AC-033: this comment used to describe a working, optional
# collector, which was never accurate). Explored and deliberately parked --
# see docs/11-known-issues.md B4 for why (the API's own key-rejection 403
# is indistinguishable from Cloudflare's anti-bot 403 from outside, which
# made "is my key just wrong" unanswerable without a paid key to test
# against). Left here as a placeholder for if that gets revisited, not as
# live configuration.
JOOBLE_API_KEY=

# --- Long-tail sources via n8n (ADR-008), PARKED -- setting this has no effect
# No N8nCollector exists in src/ and nothing reads these variables
# (docs/audit AC-033). CLAUDE.md still names this as the intended P3
# mechanism for long-tail sources, and ADR-008 records the design
# reasoning (n8n is never the orchestrator, never on the critical path) --
# but it was never built. Left here as a placeholder for that future work,
# not as live configuration.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# --- Storage -----------------------------------------------------------------
# SQLite file. Gitignored; back it up (M8).
DATABASE_PATH=./data/argos.db

# --- HTTP API (M9) ------------------------------------------------------------
# Every HTTP/MCP request uses `Authorization: Bearer <credential>` (ADR-047).
# Generate a different value for every configured principal, e.g. with
# `openssl rand -hex 32`; the process rejects duplicate values at startup.
# Full access; required. During migration only, legacy API_KEY is accepted as
# a fallback when API_ADMIN_KEY is absent.
API_ADMIN_KEY=
# API_KEY=

# Operational automation (Hermes): read APIs plus collect/dedup/deliver/study
# plan. Cannot use external ingest or permanently discard a posting.
API_AUTOMATION_KEY=

# Hermes reporting application feedback (ADR-075) — a recruiter response, an
# interview, an outcome, all read from Hermes's own Gmail access entirely
# outside this codebase. POST /mcp only: list_postings, mark_applied/
# unmark_applied, record_application_event/list_application_events. Never
# discard_posting or any run_*/get_study_plan tool.
API_FEEDBACK_KEY=

# Source-bound machine credentials. Each can only POST
# /runs/collect/external with the matching body.source.
INGEST_CATHO_API_KEY=
INGEST_INDEED_API_KEY=
INGEST_LINKEDIN_API_KEY=
# Port the HTTP server listens on inside the container. Bound to Atlas's
# Tailscale interface at the compose level (compose.production.yaml), not
# exposed publicly.
API_PORT=3000

# Atlas's own Tailscale interface IP (`tailscale ip -4`). Read only by
# compose.production.yaml's `ports:` mapping, never by the app itself — kept
# out of source because a re-keyed Tailscale identity changes it. Not
# required outside compose (leave blank for local `npm run start:dev`).
ATLAS_TAILSCALE_IP=

# --- Caminhos de arquivo (todos com padrão; sobrescreva só se precisar) -------
# Lidos pelo código e antes ausentes daqui — a omissão de TAXONOMY_PATH no
# Dockerfile derrubou o container em produção (2026-08-15), então a lista
# completa passa a viver aqui.
CRITERIA_PATH=./config/criteria.yaml
PROFILE_PATH=./config/profile.yaml
TAXONOMY_PATH=./config/taxonomy.yaml
BACKUPS_DIR=./backups
