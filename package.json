{
  "name": "argos-career",
  "version": "0.1.0",
  "description": "Collects internship postings, scores them against a master profile and delivers a ranked digest to Telegram.",
  "private": true,
  "license": "MIT",
  "author": "Gustavo Pinto",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "argos": "dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "cli": "tsx --env-file-if-exists=.env src/cli/main.ts",
    "fixture:gupy": "tsx scripts/fixture-gupy.ts",
    "fixture:ciee": "tsx scripts/fixture-ciee.ts",
    "fixture:solides": "tsx scripts/fixture-solides.ts",
    "fixture:jooble": "tsx --env-file-if-exists=.env scripts/fixture-jooble.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "measure:prefilter": "tsx scripts/measure-prefilter-cut.ts",
    "probe:terms": "tsx scripts/probe-query-terms.ts",
    "probe:indeed": "tsx scripts/probe-indeed-terms.ts",
    "report:scoring": "tsx scripts/report-scoring.ts",
    "calibration:generate": "tsx scripts/generate-calibration-set.ts",
    "calibration:expand": "tsx scripts/select-calibration-batch.ts",
    "calibration:run": "tsx --env-file-if-exists=.env scripts/run-calibration.ts",
    "score:one": "tsx --env-file-if-exists=.env scripts/score-one.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "job-search",
    "llm",
    "typescript",
    "nestjs",
    "hexagonal-architecture"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
